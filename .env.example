# ============================================================
# CropShield AI - Zero-Cost Environment Configuration
# ============================================================

# 1. AI Provider ('gemini' or 'rule-based')
# For 100% free offline execution without API keys, leave as 'rule-based'
# For Google Gemini Free Tier, get a free key at https://aistudio.google.com/
AI_PROVIDER=rule-based
GEMINI_API_KEY=

# 2. Supabase Free Tier Configuration
# Get these free credentials from your Supabase project dashboard (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 3. Weather Service
# Powered by Open-Meteo (100% Free, NO API key required)
# Default coordinates if no farm location is selected (e.g., Andhra Pradesh agricultural region)
DEFAULT_LATITUDE=16.5449
DEFAULT_LONGITUDE=81.5212

# 4. App URL (for production and preview links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
